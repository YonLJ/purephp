services:
    -
        class: Pure\StaticAnalysis\ComponentCallCollector
        tags:
            - phpstan.collector
    -
        class: Pure\StaticAnalysis\RegistryCallCollector
        tags:
            - phpstan.collector

rules:
    - Pure\StaticAnalysis\UnknownComponentRule

parameters:
    level: 9
    paths:
        - src
        - tests
        - bin/pure
    # The examples call global functions defined by files they require at
    # runtime; scanning them keeps analyzers from reporting those as undefined.
    scanDirectories:
        - examples
        - bench
    # The CallTest units are generated under the system temp directory at test
    # time; their call functions are discovered from this stub instead.
    scanFiles:
        - tests/Support/CallFixtures.scan.php
    excludePaths:
        - vendor
    ignoreErrors:
        # Allow magic static methods in HTML/SVG/XML classes
        - '#Call to an undefined static method Pure\\Core\\(HTML|SVG|XML)::[a-zA-Z0-9_]+\(\)#'
        # Allow dynamic calls in Tag/HTML/SVG/XML classes for attributes and in
        # Call for component props
        - '#Call to an undefined method Pure\\Core\\(Tag|HTML|SVG|XML)::[a-zA-Z0-9_]+\(\)#'
        - '#Call to an undefined method Pure\\Component\\Call::[a-zA-Z0-9_]+\(\)#'
        # Allow mixed to string casting in template engine
        - '#Cannot cast mixed to string#'
        # The tests register components from heredoc fixtures the analyser
        # cannot see; component names are validated by pure check there.
        -
            identifier: purephp.unknownComponent
            paths:
                - tests/*

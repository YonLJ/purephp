#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoload = __DIR__ . '/../vendor/autoload.php';

if (!is_file($autoload)) {
    $autoload = __DIR__ . '/../../../autoload.php';
}

require $autoload;

/** @var list<string> $argv */
$argv = $_SERVER['argv'] ?? [];

exit((new Pure\Compile\Internal\ArtifactCommand(
    static fn (string $file): array => Pure\Component\Registry::unitsFor($file)
))->run($argv));

#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoload = __DIR__ . '/../vendor/autoload.php';

if (!is_file($autoload)) {
    $autoload = __DIR__ . '/../../../autoload.php';
}

require $autoload;

/** @var list<string> $argv */
$argv = $_SERVER['argv'] ?? [];

$units = static fn (string $file): array => Pure\Component\Registry::unitsFor($file);

exit(match ($argv[1] ?? null) {
    'check' => (new Pure\Compile\Internal\CheckCommand($units))->run($argv),
    default => (new Pure\Compile\Internal\ArtifactCommand($units))->run($argv),
});
